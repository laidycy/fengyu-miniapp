{
  "name": "丰鱼天下-taro",
  "version": "1.0.0",
  "private": true,
  "description": "水库垂钓预约平台 - 微信小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:weapp:swc": "taro build --type weapp --watch --use-swc",
    "build:weapp:swc": "taro build --type weapp --use-swc"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@swc/core": "^1.10.0",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.57.0",
    "postcss": "^8.4.47",
    "sass": "^1.77.0",
    "stylelint": "^16.0.0",
    "typescript": "^5.6.0",
    "webpack": "5.91.0"
  }
